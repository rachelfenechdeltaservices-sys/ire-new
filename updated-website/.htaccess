# Top 10 Irish Casino - Apache settings
Options -Indexes
ErrorDocument 404 /404.html

# Private CMS settings must never be downloadable, wherever they are placed
<FilesMatch "^(cms-config\.php|cms-config\.example\.php|\.cms-login-attempts\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Repository files that are not part of the public website (the same folder is used for GitHub and public_html)
<IfModule mod_alias.c>
    RedirectMatch 404 ^/(\.git|\.github|_cms|content|cms-private)(/|$)
</IfModule>
<FilesMatch "^(\.gitignore|\.gitattributes|CMS-SETUP\.md|CMS-LOGIN-GUIDE\.html|UPDATE-STEPS\.txt|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Offer short links (/link1, /link2, ...). Add hand-written redirects here, outside the CMS block.
<IfModule mod_rewrite.c>
RewriteEngine On
</IfModule>

# BEGIN CMS offer links
# Generated by _cms/build.py from the offers' "Affiliate destination" field in the CMS.
# Do not edit inside this block - change the offer in /admin/ instead.
# Add your own redirects outside this block (above or below), e.g.:
#   RewriteRule ^link1/?$ https://partner.example/?c=123 [R=302,L,NE,QSA]
# (no affiliate destinations filled in yet)
# END CMS offer links
